def retrieve_pkg_revid(pkg: pyalpm.Package) -> str | None:
    """Extract the revision id from PKG's name. Return None if the name does not include the revision id."""
    rev_id = pkg.version.rsplit(".")[-1].split("-")
    if len(rev_id[0]) != 7:
        return None
    else:
        return rev_id[0]


async def get_git_source_url(pkg: str) -> str | None:
    """Find out the source URL for pkg and return it."""
    proc = await asyncio.create_subprocess_exec(
        "auracle",
        "show",
        pkg,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    stdout, stderr = await proc.communicate()
    if proc.returncode != 0:
        print(f"Error retrieving PKGBUILD for {pkg}:\n{stderr.decode()}")
        return None

    tmpfile = NamedTemporaryFile(mode="w", delete=False)
    with tmpfile as f:
        f.writelines(stdout.decode())

    try:
        proc = await asyncio.create_subprocess_exec(
            "sh",
            "-c",
            f'source {tmpfile.name} && set -- $source && echo "$@"',
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )
        stdout, stderr = await proc.communicate()
        if proc.returncode != 0:
            print(
                f'Could not extract source URLS of package "{pkg}":\n{stderr.decode()}'
            )
            return None

    finally:
        os.unlink(tmpfile.name)

    git_url = [x for x in stdout.decode().split("\n") if x.startswith("git+")]
    if len(git_url) > 1:
        print(f"More than one source URL found for {pkg}. Confusion!")
        return None
    elif len(git_url) == 0:
        print(f"No source URL found for {pkg}. Cannot update package.")
        return None
    else:
        return git_url[0][4:]


async def check_for_new_git_commit(pkg: str, rev_id: str = "") -> bool:
    """Check if there's a newer commit than rev_id. False can mean either that the package is up-to-date or that there has been an error with the checking process."""
    git_url = await get_git_source_url(pkg)
    # False if we did not get a git URL
    if not git_url:
        fancy_echo(
            f"Skipping update process for {pkg}...", prefix_color=TERMCOLORS["red"]
        )
        return False
    proc = await asyncio.create_subprocess_exec(
        "git",
        "ls-remote",
        git_url,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    stdout, stderr = await proc.communicate()
    # False if git ls-remote failed
    if proc.returncode != 0:
        print(f"Could not access {git_url}:\n{stderr}")
        fancy_echo(
            f"Skipping update process for {pkg}...", prefix_color=TERMCOLORS["red"]
        )

    newest_commit = stdout.decode().split("\n")[0][:7]
    if newest_commit != rev_id:
        return True
    else:
        return False


def check_for_git_pkg_update(conf: Config, pkg: pyalpm.Package) -> bool:
    """Return True/False depending on whether PKG should be updated."""
    # check first if the most recent update is older than git_interval in the config allows
    interval_secs = conf.git_interval * 60 * 60 * 24
    rev_id = retrieve_pkg_revid(pkg)
    if pkg.installdate + interval_secs < time_ns():
        return False
    # if we were unable to determine the revision id, schedule an update (bit opinionated)
    elif not rev_id:
        return True
    # finally check if the installed revision is the most recent one
    else:
        check_for_new_git_commit(pkg.name, rev_id=rev_id)


def gather_update_info(conf: Config, updates: UpdateInfo):
    """Checks for updates from available sources."""
    headline_echo("Checking for updates in the pacman repos...")
    call_shell_cmd("sudo pacman -Sy", stdout=subprocess.DEVNULL)
    updates["pm_updates"] = get_stdout_lines("pacman -Quq")
    print_package_info(updates["pm_updates"])

    headline_echo("Checking for updates in the AUR...")
    updates["aur_updates"] = get_stdout_lines("auracle outdated --quiet")
    # remove AUR updates that have been moved to official repos
    updates["aur_updates"] = [
        x for x in updates["aur_updates"] if x not in updates["pm_updates"]
    ]
    print_package_info(updates["aur_updates"], source="AUR")

    headline_echo("Checking for updates for git-based packages...")
    git_pkgs = [pkg for pkg in conf.pm_db.pkgcache if pkg.name.endswith("-git")]
    # get rid of pkgs already updated covered in the aur_update list right away
    git_pkgs = [pkg for pkg in git_pkgs if pkg.name not in updates["aur_updates"]]


if __name__ == "__main__":
    check_for_programs()
    conf = Config()
    updates = UpdateInfo()
    check_mirrorlist(conf)
    check_mailinglist(conf)
